{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "apps/server/drizzle/**",
    "packages/pricing/data/**",
    "tools/oxlint/anti-slop/**",
    ".claude/**"
  ],
  "sortImports": true,
  "sortPackageJson": true
}

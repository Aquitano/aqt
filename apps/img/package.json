    "@tanstack/react-start": "latest",
    "arktype": "^2.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",

{
  "name": "aqt-gallery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter '@aqt/gallery-*' dev",
    "build": "bun run --filter '@aqt/gallery-*' build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "db:push": "bun run --cwd packages/db db:push",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "check": "vp check",
    "typecheck": "bun run --filter '@aqt/gallery-*' typecheck",
    "test": "bun test && vp test run"
  },
  "dependencies": {
    "@aqt/gallery-env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aqt/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0"
  }
}

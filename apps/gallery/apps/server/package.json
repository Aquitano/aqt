{
  "name": "@aqt/gallery-server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "media:migrate": "bun run src/scripts/migrate-uploads-to-s3.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@aqt/gallery-auth": "workspace:*",
    "@aqt/gallery-db": "workspace:*",
    "@aqt/gallery-env": "workspace:*",
    "@aqt/gallery-layout": "workspace:*",
    "@hono/mcp": "^0.3.0",
    "@hono/trpc-server": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "catalog:",
    "sharp": "^0.35.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aqt/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:"
  }
}

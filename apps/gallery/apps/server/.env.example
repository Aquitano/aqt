# Postgres (Neon). Migrations: `bun run db:migrate` from apps/gallery.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Clerk instance keys. Production needs the live pair of a production instance.
CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_SECRET_KEY=sk_test_replace
# Signing secret of the user.deleted webhook pointed at <SERVER_URL>/webhooks/clerk.
# Empty leaves the endpoint answering 503 and deleted accounts' data in place.
CLERK_WEBHOOK_SIGNING_SECRET=

# This server's public origin (absolute image URLs) and the web app's origin
# (CORS and Clerk authorizedParties). Browser sessions are cookies, so both
# must share a registrable domain in production.
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Cloudflare R2 over S3. All four or none; none falls back to UPLOAD_DIR on disk.
S3_BUCKET=aqt-gallery-media
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Trusted proxy hops in front of this server, for the anonymous rate limiters.
# Defaults to 1, the reverse proxy on the box; 2 with Cloudflare proxying in front.
TRUSTED_PROXY_HOPS=

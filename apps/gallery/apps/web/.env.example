# Baked into the client bundle at build time.
VITE_SERVER_URL=http://localhost:3000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace

# Read at runtime by the SSR auth middleware (src/middleware/auth.ts). Without
# it every server-side session check fails closed and protected routes
# redirect to /login even when the browser is signed in.
CLERK_SECRET_KEY=sk_test_replace

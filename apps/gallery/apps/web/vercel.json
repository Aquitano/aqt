{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "bunVersion": "1.4.x",
  "installCommand": "cd ../../../.. && bun install --frozen-lockfile --filter aqt-gallery --filter '@aqt/gallery-*'",
  "buildCommand": "vite build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../.. ../../../../bun.lock",
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.gallery.aquitano.me/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}

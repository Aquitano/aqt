{
  "extends": "@aqt/config/tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "moduleResolution": "nodenext"
  },
  "include": ["vite.config.ts"]
}

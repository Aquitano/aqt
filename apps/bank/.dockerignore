# The build context should be the source and nothing else: a stray archive or
# blob store here would be baked into an image layer.
.git
.claude
.env
bank
*.log

# Local data directories, if anyone points BANK_DATA_DIR at the repo.
.bankdata
blobs/
archive/
inbox/

# IMAP collector config, certificates and its queue of decrypted mail.
imap.json
config.json
*.pem
state/
imap-state/

{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@aqt-gallery/auth": "workspace:*",
		"@aqt-gallery/db": "workspace:*",
		"@aqt-gallery/env": "workspace:*",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "^0.45.1",
		"dotenv": "catalog:",
		"effect": "beta",
		"hono": "catalog:",
		"sharp": "^0.34.5",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aqt-gallery/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.21.9",
		"typescript": "catalog:"
	}
}

# Postgres from docker-compose.yml.
TRACKER_DATABASE_URL=postgres://tracker:tracker@127.0.0.1:5435/tracker?sslmode=disable
# Where serve listens. Loopback only: there is no auth by default, and on
# loopback none is wanted. With COMPOSE_PROFILES=server it is the host address
# the container is published on instead: the tailnet address on the VPS, never
# 0.0.0.0, since serve has no TLS.
TRACKER_LISTEN=127.0.0.1:8490
# Extraction workers `serve` runs in-process.
TRACKER_WORKERS=3
# debug | info | warn | error
TRACKER_LOG_LEVEL=info

# What the CLI talks to; stats and search read the server, not the database.
TRACKER_SERVER_URL=http://127.0.0.1:8490

# Authentication is off while the issuer is empty. `serve` needs the issuer and
# the audience to require a bearer token on every route but /healthz and
# /metrics; the client id is the CLI's alone.
TRACKER_OIDC_ISSUER=
# What `serve` requires in a token's aud claim, usually the client id.
TRACKER_OIDC_AUDIENCE=
# Who the CLI signs in as with `tracker login`.
TRACKER_OIDC_CLIENT_ID=
# Where the CLI keeps its token; defaults under the user config directory. The
# desktop agent reads and refreshes the same file, so one login covers both.
# Empty means no token at all; unset keeps the default location.
TRACKER_TOKEN_PATH=
# The one extension whose origin `serve` accepts; the manifest pins this id.
# Empty accepts any chrome-extension:// origin.
TRACKER_EXTENSION_ID=gdhnnekkmghgkiikgmdodggcpgnmbpno

# docker compose (README: Deploying to the VPS). A laptop leaves all of these
# empty.
# Which services start besides Postgres, its backup and Grafana. `server` is
# the tracker in a container, which the VPS runs; empty adds none.
COMPOSE_PROFILES=
# Postgres's password, read only when it initialises an empty data directory,
# so set it before the first `up`. Letters and digits: it goes into a URL.
# Empty means `tracker`.
POSTGRES_PASSWORD=
# Where Postgres keeps its data: an absolute path is a bind mount, such as
# /data/aqt-tracker/pgdata on the VPS's encrypted volume. Empty means a docker
# volume.
TRACKER_PG_DIR=
# Where the daily pg_dump lands, such as /data/aqt-tracker/backups. Empty means
# a docker volume, or ~/Library/Application Support/tracker/backups with the
# laptop overlay.
TRACKER_BACKUP_DIR=
# Host address Grafana is published on, the tailnet address and port 3090 on
# the VPS. Empty means 127.0.0.1:3090.
TRACKER_GRAFANA_LISTEN=
# Grafana's admin password, read only when its volume is empty; change it in
# Grafana after that. Empty means `admin`, which Grafana asks to replace at the
# first login. The laptop overlay turns the login off.
TRACKER_GRAFANA_PASSWORD=

# Desktop agent (apps/tracker/desktop), read from the LaunchAgent plist, not
# from a shell. Comma lists; empty means none, unset keeps the default. The
# Windows agent reads the same variables holding exe names; see the README.
# Browsers the extension already covers, so their time is not counted twice.
TRACKER_SKIP_BUNDLE_IDS=com.google.Chrome,com.google.Chrome.canary,com.google.Chrome.beta,org.chromium.Chromium,com.brave.Browser,com.microsoft.edgemac,company.thebrowser.Browser,com.vivaldi.Vivaldi
# Apps whose window title is never recorded.
TRACKER_PRIVATE_BUNDLE_IDS=com.1password.1password,com.apple.keychainaccess,com.apple.Passwords
# Overlays that take focus without taking attention; the span underneath stays open.
TRACKER_IGNORE_BUNDLE_IDS=com.apple.dock,com.apple.loginwindow,com.apple.SecurityAgent,com.apple.LocalAuthentication.UIAgent,com.apple.UserNotificationCenter,com.jordanbaird.Ice,com.electron.wispr-flow

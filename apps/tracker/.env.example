# Postgres from deploy/docker-compose.yml.
TRACKER_DATABASE_URL=postgres://tracker:tracker@127.0.0.1:5434/tracker?sslmode=disable
# Loopback only: there is no auth, and none is wanted.
TRACKER_LISTEN=127.0.0.1:8490
# Extraction workers `serve` runs in-process.
TRACKER_WORKERS=3
# debug | info | warn | error
TRACKER_LOG_LEVEL=info

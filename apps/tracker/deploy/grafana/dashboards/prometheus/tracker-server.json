{
  "uid": "tracker-server",
  "title": "tracker server",
  "tags": ["tracker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Derivation queue depth",
      "datasource": { "type": "prometheus", "uid": "tracker-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "tracker_derivations_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Oldest pending derivation",
      "datasource": { "type": "prometheus", "uid": "tracker-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "tracker_derivations_oldest_age_seconds",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "datasource": { "type": "prometheus", "uid": "tracker-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (status) (rate(tracker_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Extract duration p95 by extractor",
      "datasource": { "type": "prometheus", "uid": "tracker-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, extractor) (rate(tracker_extract_duration_seconds_bucket[5m])))",
          "legendFormat": "{{extractor}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Table size",
      "datasource": { "type": "prometheus", "uid": "tracker-prom" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "tracker_table_bytes",
          "legendFormat": "{{table}}"
        }
      ]
    }
  ]
}

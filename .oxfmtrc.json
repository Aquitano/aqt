{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.gen.ts",
    "**/worker-configuration.d.ts",
    "**/drizzle/**",
    "tools/oxlint/anti-slop/**"
  ]
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.gen.ts",
    "**/worker-configuration.d.ts",
    "**/drizzle/**",
    ".claude/**",
    "tools/oxlint/anti-slop/**",
    "**/generated/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/.output/**",
    "apps/gallery/packages/db/src/migrations/**",
    "apps/bank/internal/webui/app/dist/**",
    "apps/bank/internal/webui/app/dist/"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-misused-promises": [
      "warn",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/await-thenable": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/only-throw-error": [
      "warn",
      {
        "allow": [
          {
            "from": "lib",
            "name": "Response"
          },
          {
            "from": "package",
            "name": ["Redirect", "NotFoundError"],
            "package": "@tanstack/router-core"
          }
        ]
      }
    ],
    "typescript/use-unknown-in-catch-callback-variable": "warn",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reflect-apply": "warn",
    "anti-slop/no-reflect-get": "warn",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "warn",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "no-useless-escape": "warn"
  },
  "overrides": [
    {
      "files": ["apps/img/scripts/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": ["apps/gallery/packages/db/src/scripts/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}

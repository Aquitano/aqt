{
  "name": "aqt",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/gallery/apps/*",
      "apps/gallery/packages/*",
      "apps/img/cli",
      "apps/health/frontend",
      "apps/bank/internal/webui/app",
      "apps/bank/scripts",
      "packages/ts/*",
      "tools/stack"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "next-themes": "^0.4.6",
      "@trpc/client": "^11.16.0",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "for p in apps/gallery/apps/web apps/gallery/apps/server apps/gallery/packages/db apps/gallery/packages/auth apps/gallery/packages/env apps/gallery/packages/ui apps/img apps/img/cli apps/health/frontend tools/stack packages/ts/ui apps/bank/scripts; do tsc --noEmit -p $p || exit 1; done && tsc -b apps/bank/internal/webui/app"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2"
}

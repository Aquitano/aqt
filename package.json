{
  "name": "aqt",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/gallery/apps/*",
      "apps/gallery/packages/*",
      "apps/img/cli",
      "apps/bank/internal/webui/app",
      "apps/bank/scripts",
      "apps/tracker/extension",
      "packages/ts/*",
      "tools/stack"
    ],
    "catalog": {
      "dotenv": "^18.0.5",
      "zod": "^4.6.5",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "hono": "^4.13.12",
      "@trpc/server": "^11.19.0",
      "next-themes": "^0.4.6",
      "@trpc/client": "^11.19.0",
      "@types/react-dom": "^19.3.0",
      "lucide-react": "^1.49.0"

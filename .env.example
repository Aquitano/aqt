# Local development: the CLI talks straight to Postgres, no server needed.
DATABASE_URL=postgres://bank:bank@localhost:5433/bank?sslmode=disable
# blobs/, archive/ and inbox/ live here; default is ~/.local/share/aqt-bank
#BANK_DATA_DIR=/data/aqt-bank

# --- docker compose --profile server (see DEPLOY.md) ---
# Set this before the first `docker compose up`, or Postgres keeps the weak default.
#POSTGRES_PASSWORD=change-me
# Where Postgres keeps its data. A bare name is a docker volume, an absolute
# path is a bind mount onto the encrypted volume.
#BANK_PG_DIR=/data/pgdata
# Host address:port the server is published on. A tailnet address — never
# 0.0.0.0, there is no TLS.
#BANK_LISTEN=100.x.y.z:8480
# Must own BANK_DATA_DIR on the host. 65532 is the image's nonroot user.
#BANK_UID=65532
#BANK_GID=65532
# Local time for date filters and WhatsApp export timestamps.
#TZ=Europe/Berlin
